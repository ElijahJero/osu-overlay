OSU_CLIENT_ID=60688
OSU_CLIENT_SECRET=

# Christmas theme for the home page and the overlay.
#   always     on every day
#   never      off
#   christmas  December 15 through December 25 (Christmas and the 10 days before)
# The window uses the container clock. TZ defaults to America/New_York in Compose.
OSU_CHRISTMAS=christmas
# TZ=America/New_York
